# ============================================================
# eFootball Rewards — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Django
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Base de données PostgreSQL
DB_NAME=efootball_rewards
DB_USER=efootball
DB_PASSWORD=efootball_secret
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/1

# Email SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=no-reply@efootball-rewards.com

# Sécurité (production uniquement)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
